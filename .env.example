# Copy to server/.env for local development (or set these on your host).
DATABASE_URL=postgres://dev:dev@localhost:5432/clinicq
# Long random string; required in production. e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
# Seed and keep alive the public "Sunrise Family Clinic" demo.
DEMO_MODE=true
PORT=3000
